{
  "name": "medical-equipment-advisor",
  "version": "1.0.0",
  "description": "MCP server that helps medical-equipment vendors recommend the right machine based on disease, patient volume, and budget.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "medical-equipment-advisor": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "medical",
    "equipment",
    "recommendation",
    "healthcare"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
